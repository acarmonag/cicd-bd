# ---------------------------------------------------------------------------
# Plantilla de variables de entorno — Momentos 2 y 3
#
# Uso:
#   cp .env.example .env
#   Completa cada valor con datos reales. El .env NUNCA se versiona
#   (ver .gitignore) — cero credenciales reales en el repositorio.
#
# Para el proyecto dbt (Momento 3), copia también dbt/profiles.yml.example
# como dbt/profiles.yml y apunta al mismo .env.
# ---------------------------------------------------------------------------

# Neon — branch dev del proyecto de torneos (la misma del Momento 1, la que
# migra Flyway en los pull requests). Nunca la de main/prod.
NEON_DEV_DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Snowflake — de dónde sale cada valor:
#   SNOWFLAKE_ACCOUNT   Snowsight -> perfil (abajo izquierda) -> Account ->
#                       "Account identifier". Formato <organización>-<cuenta>,
#                       ej. ABCDEFG-XY12345
#   SNOWFLAKE_USER      Tu usuario de Snowsight.
#   SNOWFLAKE_PASSWORD  Su contraseña.
#   El resto son los nombres que crea snowflake/setup/01_setup_snowflake.sql —
#   no los cambies salvo que también edites ese script.
SNOWFLAKE_ACCOUNT=tu_identificador_de_cuenta
SNOWFLAKE_USER=tu_usuario
SNOWFLAKE_PASSWORD=tu_password
SNOWFLAKE_WAREHOUSE=WH_TORNEOS
SNOWFLAKE_DATABASE=TORNEOS_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=TORNEOS_LOADER
