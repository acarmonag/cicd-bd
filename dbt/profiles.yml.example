# Plantilla de profiles.yml — cópiala como profiles.yml en esta misma carpeta
# y NO la versiones con credenciales reales.
#
# dbt busca profiles.yml en ~/.dbt/ por defecto. Para mantenerlo junto al
# proyecto sin arriesgar un commit accidental, corre los comandos con:
#   uv run dbt <comando> --profiles-dir .
#
# Todos los valores se leen de variables de entorno con env_var() — nunca hay
# una credencial en texto plano aquí, ni siquiera en la copia local.
torneos_dbt:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'TORNEOS_LOADER') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'WH_TORNEOS') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'TORNEOS_DB') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA', 'RAW') }}"
      threads: 4
      client_session_keep_alive: false
